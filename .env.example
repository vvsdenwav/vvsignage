# =============================================================================
# Tropic Air Digital Signage — Required Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel), set these as Project Environment Variables.
#
# NEVER commit .env.local or .env.production with real values to git.
# =============================================================================

# --- Database ---
# PostgreSQL connection string (Neon, Supabase, Vultr Managed DB, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- NextAuth ---
# REQUIRED. Generate a strong secret: openssl rand -base64 32
# This is also used as the JWT signing secret for TV device tokens.
NEXTAUTH_SECRET="your-very-strong-random-secret-here"
NEXTAUTH_URL="https://your-cms-domain.vercel.app"

# --- Vercel Blob (Media Storage) ---
# Required for uploading images and videos via the CMS media library.
# Create a Blob store in your Vercel project dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Cron Job Security ---
# REQUIRED if using Vercel Cron or external schedulers.
# Set the same value in your cron request header: Authorization: Bearer <value>
# Generate: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# --- Email Alerts (Offline Screen Notifications) ---
# SMTP configuration for the automated offline-screen alert system.
# If using Gmail: enable App Passwords, host=smtp.gmail.com, port=587
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT="587"
SMTP_USER="alerts@tropicair.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Tropic Air Signage <alerts@tropicair.com>"

# Fallback alert recipient (can also be configured via CMS Settings UI)
ALERT_EMAIL_RECIPIENT="it@tropicair.com"

# --- Optional: Microsoft Teams Webhook ---
# Configured via CMS Settings UI — no env var needed unless you want a default.
# TEAMS_WEBHOOK_URL="https://outlook.office.com/webhook/..."
